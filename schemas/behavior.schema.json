{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EidolonBehaviorModel",
  "type": "object",
  "required": [
    "version",
    "response_policies",
    "conversation_rhythm"
  ],
  "properties": {
    "version": { "type": "string" },
    "response_policies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "situation": { "type": "string" },
          "strategy": { "type": ["string", "null"] },
          "observed_strategy": { "type": ["string", "null"] },
          "evidence_count": { "type": "number" },
          "confidence": { "type": ["string", "number"] },
          "length_bias": { "type": "string", "enum": ["micro", "short", "medium", "long"] },
          "emoji_probability": { "type": "number", "minimum": 0, "maximum": 1 },
          "follow_up_probability": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "conversation_rhythm": {
      "type": "object",
      "required": ["base_delay_ms"],
      "properties": {
        "base_delay_ms": { "type": ["number", "null"], "minimum": 500 },
        "p90_delay_ms": { "type": ["number", "null"] },
        "typing_speed_cpm": { "type": ["number", "null"] },
        "response_latency": { "type": "object" },
        "latency_model": { "type": "object" },
        "double_message_probability": { "type": "number", "minimum": 0, "maximum": 1 },
        "topic_switch_probability": { "type": "number", "minimum": 0, "maximum": 1 },
        "typing_model": { "type": "object" }
      }
    },
    "conditional_style": {
      "type": "object"
    },
    "reply_mode_preference": {
      "type": "object",
      "properties": {
        "quote_reply_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "direct_send_rate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
