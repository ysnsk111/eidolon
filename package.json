{
  "name": "eidolon",
  "version": "1.3.1",
  "description": "Persona Distillation & Memory Runtime — Preserve expression. Reconstruct context. Measure fidelity.",
  "main": "cli/index.js",
  "type": "module",
  "bin": {
    "eidolon": "./cli/index.js"
  },
  "scripts": {
    "start": "node cli/index.js",
    "test": "node --test tests/**/*.test.js",
    "test:distillation": "node --test tests/distillation/**/*.test.js",
    "test:evaluation": "node --test tests/evaluation/**/*.test.js",
    "test:regression": "node --test tests/integration/**/*.test.js",
    "build:server": "cd server && go build -o ../bin/eidolon-server ./cmd/eidolon-server"
  },
  "keywords": [
    "persona",
    "distillation",
    "memory",
    "runtime",
    "ai",
    "llm",
    "evaluation",
    "dsi",
    "telegram",
    "chat-analysis"
  ],
  "author": "EIDOLON Contributors",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "archiver": "^7.0.1",
    "cheerio": "^1.0.0",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "ora": "^8.2.0",
    "pdf-parse": "^1.1.1",
    "picocolors": "^1.1.1",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0"
  }
}
